{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Automattic/jetpack-stats-on-paper/blob/main/docs/stats.schema.json",
  "title": "Jetpack Stats on Paper snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "site",
    "fetched_at",
    "age_seconds",
    "today",
    "yesterday",
    "series",
    "all_time",
    "commerce",
    "source"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "site": {
      "$ref": "#/$defs/site"
    },
    "fetched_at": {
      "type": "string",
      "format": "date-time"
    },
    "age_seconds": {
      "type": "integer",
      "minimum": 0
    },
    "today": {
      "$ref": "#/$defs/totals"
    },
    "yesterday": {
      "$ref": "#/$defs/totals"
    },
    "series": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dayPoint"
      }
    },
    "all_time": {
      "oneOf": [
        {
          "$ref": "#/$defs/totals"
        },
        {
          "type": "null"
        }
      ]
    },
    "commerce": {
      "oneOf": [
        {
          "$ref": "#/$defs/commerce"
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "enum": [
        "wpcom",
        "parsely"
      ]
    }
  },
  "$defs": {
    "site": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "url"
      ],
      "properties": {
        "id": {
          "type": [
            "integer",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "views",
        "visitors",
        "likes",
        "comments"
      ],
      "properties": {
        "views": {
          "type": "integer",
          "minimum": 0
        },
        "visitors": {
          "type": "integer",
          "minimum": 0
        },
        "likes": {
          "type": "integer",
          "minimum": 0
        },
        "comments": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "dayPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "views",
        "visitors"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date"
        },
        "views": {
          "type": "integer",
          "minimum": 0
        },
        "visitors": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "commerce": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orders"
      ],
      "properties": {
        "orders": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}

