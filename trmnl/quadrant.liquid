<div class="view view--quadrant">
  <div class="layout">
    <span class="label">Views today</span>
    <span class="value value--large">{{ today.views | number_with_delimiter }}</span>
    <span class="description">{{ today.visitors | number_with_delimiter }} visitors</span>
  </div>
  <div class="title_bar">
    <span class="title">{{ site.name }}</span>
  </div>
</div>
