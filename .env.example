# WordPress.com OAuth application ID.
WPCOM_CLIENT_ID=
# WordPress.com OAuth application secret. Never commit the real value.
WPCOM_CLIENT_SECRET=
# Domain (example.com) or numeric site ID.
WPCOM_SITE=
# OAuth scope requested by `sop login`: stats grants one site (least
# privilege); global grants every site your account can access, so you can
# switch WPCOM_SITE without authorizing again.
WPCOM_SCOPE=stats
# OAuth callback registered for the application. Manual login can use a URL
# whose redirect page does not load; paste that final URL back into `sop`.
WPCOM_REDIRECT_URI=http://localhost/callback

# OAuth token file. Default: ~/.config/sop/token.json. Point this at a
# per-site file to keep several site tokens side by side.
SOP_TOKEN_PATH=
# Snapshot cache directory. Default: ~/.cache/sop
SOP_CACHE_DIR=
# Number of daily points to fetch.
SOP_SERIES_DAYS=30
# Upstream snapshot cache/poll interval in seconds. The figures are daily, so
# an hour is the default and longer is fine. The panel's 20–25 second physical
# refresh duration is a redraw time, not a polling cadence.
SOP_POLL_INTERVAL_SECONDS=3600
# Stats day boundaries follow the site timezone.
SOP_TZ=Europe/Madrid
# direct reads WordPress.com; url reads another `sop serve` instance.
SOP_SOURCE=direct
# Required when SOP_SOURCE=url. Points at the base URL of `sop serve`.
SOP_SOURCE_URL=
# Bearer token required by `sop serve`.
SOP_SERVE_TOKEN=
# Enable the optional WooCommerce order counter. Required by SOP_VIEW=commerce
# on whichever process fetches: this one for SOP_SOURCE=direct, the upstream
# `sop serve` for SOP_SOURCE=url.
SOP_COMMERCE=false

# Which screen to draw: stats or commerce. `--view` overrides it.
SOP_VIEW=stats
# Which panel `sop render` and `sop display` target, e.g. impression-7in3.
# `--panel` overrides it. Set one or pass the flag.
SOP_PANEL=
