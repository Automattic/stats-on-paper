# WordPress.com OAuth application ID.
WPCOM_CLIENT_ID=
# WordPress.com OAuth application secret. Never commit the real value.
WPCOM_CLIENT_SECRET=
# Domain (example.com) or numeric site ID.
WPCOM_SITE=
# OAuth scope requested by `jsp login`: stats grants one site (least
# privilege); global grants every site your account can access, so you can
# switch WPCOM_SITE without authorizing again.
WPCOM_SCOPE=stats
# OAuth callback registered for the application. Manual login can use a URL
# whose redirect page does not load; paste that final URL back into `jsp`.
WPCOM_REDIRECT_URI=http://localhost/callback

# OAuth token file. Default: ~/.config/jsp/token.json. Point this at a
# per-site file to keep several site tokens side by side.
JSP_TOKEN_PATH=
# Snapshot cache directory. Default: ~/.cache/jsp
JSP_CACHE_DIR=
# Number of daily points to fetch.
JSP_SERIES_DAYS=30
# Upstream snapshot cache/poll interval in seconds. The figures are daily, so
# an hour is the default and longer is fine. The panel's 20–25 second physical
# refresh duration is a redraw time, not a polling cadence.
JSP_POLL_INTERVAL_SECONDS=3600
# Stats day boundaries follow the site timezone.
JSP_TZ=Europe/Madrid
# direct reads WordPress.com; url reads another `jsp serve` instance.
JSP_SOURCE=direct
# Required when JSP_SOURCE=url. Points at the base URL of `jsp serve`.
JSP_SOURCE_URL=
# Bearer token required by `jsp serve`.
JSP_SERVE_TOKEN=
# Enable the optional WooCommerce order counter. Required by JSP_VIEW=commerce
# on whichever process fetches: this one for JSP_SOURCE=direct, the upstream
# `jsp serve` for JSP_SOURCE=url.
JSP_COMMERCE=false

# Which screen to draw: stats or commerce. `--view` overrides it.
JSP_VIEW=stats
# Which panel `jsp render` and `jsp display` target, e.g. impression-7in3.
# `--panel` overrides it. Set one or pass the flag.
JSP_PANEL=
