# WordPress.com OAuth application ID.
WPCOM_CLIENT_ID=
# WordPress.com OAuth application secret. Never commit the real value.
WPCOM_CLIENT_SECRET=
# Domain (example.com) or numeric site ID.
WPCOM_SITE=
# OAuth callback registered for the application. Manual login can use a URL
# whose redirect page does not load; paste that final URL back into `jsp`.
WPCOM_REDIRECT_URI=http://localhost/callback

# Snapshot cache directory. Default: ~/.cache/jsp
JSP_CACHE_DIR=
# Number of daily points to fetch.
JSP_SERIES_DAYS=30
# Stats day boundaries follow the site timezone.
JSP_TZ=Europe/Madrid
# direct reads WordPress.com; url reads another `jsp serve` instance.
JSP_SOURCE=direct
# Required when JSP_SOURCE=url. Points at the base URL of `jsp serve`.
JSP_SOURCE_URL=
# Bearer token required by `jsp serve`.
JSP_SERVE_TOKEN=
# Enable the optional WooCommerce order counter.
JSP_COMMERCE=false

